{
  "name": "greenlogic",
  "private": true,
  "version": "0.1.0",
  "description": "Simulasi Rumah Kaca 3D Interaktif dengan Aljabar Boolean (Matematika Diskrit)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
